# Soukromé Blob úložiště připojené k projektu; nové propojení používá OIDC.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Volitelné pro starší tokenové propojení / lokální testování.
BLOB_READ_WRITE_TOKEN=
# Nejméně 32 náhodných znaků; serverové tajemství pro podpis zákaznické relace.
SESSION_SECRET=
# Brevo API klíč (nikoli SMTP klíč); pouze serverová proměnná.
BREVO_API_KEY=
# Odesílatel ověřený v Brevo: email nebo Název <email>.
EMAIL_FROM=

# Volitelné původní přihlášení správce; nové účty vytvářejte přímo v /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Jednorázový kód pro založení PRVNÍHO admina v loginu (nejméně 16 znaků).
# Po založení účtu lze proměnnou odstranit; další adminy vytváří přihlášený admin.
ADMIN_SETUP_TOKEN=
